# ---- Build stage ----
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

# apiUrl relativo: el nginx de este mismo contenedor hace de proxy hacia /api
ARG API_URL=/api
ENV API_URL=$API_URL
RUN node generate-env.js && npm run build:prod

# ---- Production stage ----
FROM nginx:1.27-alpine
COPY --from=builder /app/dist/sistema-qa/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
